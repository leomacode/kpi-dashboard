# Copy this file to `.env` and fill in your Supabase project credentials.
#
# Both variables are OPTIONAL. If either is missing or empty, the app falls
# back to in-memory mock data (see src/lib/supabase.ts + src/components/
# KPISection/data/mockKpis.ts). The UI is fully usable without a backend.
#
# Vite only exposes env vars prefixed with `VITE_` to the client bundle.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Ask your KPIs (server-side only — never prefix these with VITE_) ───────
# Read by the serverless function in api/ask.ts (and by `npm run dev`).
# AI_MODEL is "<provider>:<model>"; supported providers: anthropic, openai.
AI_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
